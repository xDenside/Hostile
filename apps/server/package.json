{
  "name": "@hostile/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.js",
    "build": "prisma generate && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "seed:dev": "tsx src/cli/seed-dev.ts",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@hostile/shared": "workspace:*",
    "@prisma/client": "7.10.1",
    "cookie": "2.0.1",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "livekit-server-sdk": "2.19.0",
    "pglite-prisma-adapter": "0.7.2",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "prisma": "7.10.1",
    "socket.io": "4.8.3",
    "ws": "8.21.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "pino-pretty": "13.1.3",
    "socket.io-client": "4.8.3",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "vitest": "5.0.1"
  }
}
