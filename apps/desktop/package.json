{
  "name": "@hostile/desktop",
  "version": "0.1.1",
  "private": true,
  "description": "Hostile desktop client",
  "author": "Hostile",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-test-module-mocks --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-esm-resolve.mjs --test \"src/**/*.test.ts\"",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@hostile/shared": "workspace:*",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2"
  }
}
